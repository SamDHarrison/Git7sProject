<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="git7s.flashcardai.controller.StatisticsController">
    <top>
        <HBox alignment="CENTER" style="-fx-padding: 5 20 10 20">
            <Label fx:id="welcomeLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Statistics" />
        </HBox>
    </top>
    <!-- Left Panel: My Statistics General & Boxes -->
    <left>
        <Pane prefWidth="300" prefHeight="300">
            <VBox alignment="TOP_CENTER" prefWidth="300" prefHeight="300" spacing="5" style="-fx-padding: 5 20 10 20;">
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="General Statistics" />
                <VBox alignment="CENTER" spacing="5">
                    <Label fx:id="lifetimeScoreLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Your lifetime score:" />
                    <ProgressBar fx:id="lifetimeScoreBar" prefHeight="20.0" prefWidth="290.0"
                                 style="-fx-accent: #60C3D8;" />

                </VBox>
                <VBox alignment="CENTER" spacing="5">
                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Your current study streak:" />
                    <Label fx:id="currentStreakDisplay" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="0 Days!"/>

                </VBox>
                <VBox alignment="CENTER" spacing="5">
                    <HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="viewStrongestButton" onAction="#viewStrongestPane" prefHeight="30" prefWidth="120" style="-fx-background-color: #60C3D8; -fx-text-fill: white; -fx-font-weight: bold;" text="View Strongest" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="viewWeakestButton" onAction="#viewWeakestPane" prefHeight="30" prefWidth="120" style="-fx-background-color: #60C3D8; -fx-text-fill: white; -fx-font-weight: bold;" text="View Weakest" />
                        <Region HBox.hgrow="ALWAYS" />
                    </HBox>
                    <HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="viewVolumeButton" onAction="#viewVolumePane" prefHeight="30" prefWidth="120" style="-fx-background-color: #60C3D8; -fx-text-fill: white; -fx-font-weight: bold;" text="View Volume" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="viewScoresButton" onAction="#viewScoresPane" prefHeight="30" prefWidth="120" style="-fx-background-color: #60C3D8; -fx-text-fill: white; -fx-font-weight: bold;" text="View Scores" />
                        <Region HBox.hgrow="ALWAYS" />
                    </HBox>
                    <HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="viewSubjectVolume" onAction="#viewSubjectVolumePane" prefHeight="30" prefWidth="120" style="-fx-background-color: #60C3D8; -fx-text-fill: white; -fx-font-weight: bold;" text="Subject Volume" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="viewSubjectScores" onAction="#viewSubjectScoresPane" prefHeight="30" prefWidth="120" style="-fx-background-color: #60C3D8; -fx-text-fill: white; -fx-font-weight: bold;" text="Subject Scores" />
                        <Region HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>
            </VBox>
        </Pane>

    </left>

    <!-- Vertical Separator -->
    <center>
        <VBox alignment="CENTER" prefWidth="2">
            <Rectangle height="250" style="-fx-fill: rgb(192,192,191);" width="2" />
        </VBox>
    </center>

    <!-- Right Panel: My Progress -->
    <right>
        <Pane fx:id="choiceStatsPane" prefHeight="300" prefWidth="300">
            <VBox fx:id="strongestSubjectPane" prefHeight="300" prefWidth="300" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 5 20 10 20;" alignment="TOP_CENTER">
                <Label fx:id="strongestTopicLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Strongest Topic: " />
                <PieChart fx:id="strongestPieChart" prefHeight="200" prefWidth="200" startAngle="45">
                </PieChart>
            </VBox>
            <VBox fx:id="weakestSubjectPane" prefHeight="300" prefWidth="300" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 5 20 10 20;" alignment="TOP_CENTER" visible="false">
                <Label fx:id="weakestTopicLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Weakest Topic: " />
                <PieChart fx:id="weakestPieChart" prefHeight="200" prefWidth="200" startAngle="45">

                </PieChart>
            </VBox>
            <VBox fx:id="weeklyScoresPane" prefHeight="300" prefWidth="300" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 5 20 10 20;" alignment="TOP_CENTER" visible="false">
                <Label fx:id="scoresLabel" style="-fx-font-size: 16px;" text="Your weekly scores over time:" />
                <LineChart fx:id="scoresChart">
                    <xAxis>
                        <NumberAxis side="BOTTOM" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis side="LEFT" />
                    </yAxis>
                </LineChart>
            </VBox>
            <VBox fx:id="weeklyVolumePane" prefHeight="300" prefWidth="300" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 5 20 10 20;" alignment="TOP_CENTER" visible="false">
                <Label fx:id="volumeLabel" style="-fx-font-size: 16px;" text="Your study volume over time:" />
                <LineChart fx:id="volumeChart">
                    <xAxis>
                        <NumberAxis side="BOTTOM"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis side="LEFT" />
                    </yAxis>
                </LineChart>
            </VBox>
            <VBox fx:id="weeklySubjectVolume" prefHeight="300" prefWidth="300" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 5 20 10 20;" alignment="TOP_CENTER" visible="false">
                <ComboBox fx:id="subjectVolumeComboBox" onAction="#handleUpdateSubjectVolumeChart" prefHeight="25.0" prefWidth="459.0" />
                <LineChart fx:id="subjectVolumeChart">
                    <xAxis>
                        <NumberAxis side="BOTTOM" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis side="LEFT" />
                    </yAxis>
                </LineChart>
            </VBox>
            <VBox fx:id="weeklySubjectScores" prefHeight="300" prefWidth="300" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 5 20 10 20;" visible="false" alignment="TOP_CENTER">
                <ComboBox fx:id="subjectScoresComboBox" onAction="#handleUpdateSubjectScoreChart" prefHeight="25.0" prefWidth="459.0" />
                <LineChart fx:id="subjectScoresChart">
                    <xAxis>
                        <NumberAxis side="BOTTOM" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis side="LEFT" />
                    </yAxis>
                </LineChart>
            </VBox>
        </Pane>
    </right>

    <!-- Log Out Button Positioned at Bottom Right -->
    <bottom>
        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 0 20 10 20;">
            <Button fx:id="backButton" onAction="#handleBackToDashboard" prefHeight="30" prefWidth="60.0" style="-fx-font-size: 16px; -fx-background-color: #60C3D8; -fx-text-fill: white;" text="Back" />
        </HBox>
    </bottom>

</BorderPane>
