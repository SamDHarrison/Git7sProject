<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/17.0.12"
            fx:controller="git7s.flashcardai.controller.LoginController">

    <center>
        <GridPane hgap="20" vgap="10" alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints percentWidth="40"/>
                <ColumnConstraints percentWidth="60"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS"/>
            </rowConstraints>

            <!-- App logo displayed using ImageView -->
            <VBox alignment="CENTER" GridPane.rowIndex="0">
                <ImageView fitHeight="240" fitWidth="240" preserveRatio="true">
                    <Image url="@flashcardlogo.png"/>
                </ImageView>
            </VBox>

            <!-- Wrap the login form in a VBox and center it vertically -->
            <VBox alignment="CENTER" GridPane.columnIndex="1">
                <VBox alignment="TOP_LEFT" spacing="15">
                    <padding>
                        <Insets top="30" right="20" bottom="20" left="20"/>
                    </padding>

                    <!-- Title -->
                    <Label text="LOGIN" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

                    <!-- Student Number input field -->
                    <TextField fx:id="usernameField" promptText="Student number" maxWidth="200"/>

                    <!-- Password input field -->
                    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="200"/>

                    <!-- Login button -->
                    <Button text="Login" onAction="#handleLogin" prefWidth="150"
                            style="-fx-background-color: #60C3D8; -fx-text-fill: white; -fx-font-weight: bold;" />

                    <!-- Account creation prompt -->
                    <HBox spacing="5">
                        <Label text="New here?" />
                        <Label text="Create Account"
                               onMouseClicked="#handleCreateAccount"
                               style="-fx-text-fill: #007BFF; -fx-underline: true; -fx-cursor: hand;" />
                    </HBox>

                    <!-- Error label -->
                    <Label fx:id="errorLabel"
                           style="-fx-font-size: 14px; -fx-text-fill: red;"
                           textAlignment="CENTER"/>
                </VBox>
            </VBox>
        </GridPane>
    </center>
</BorderPane>
