<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/17.0.12"
            fx:controller="git7s.flashcardai.controller.LoginController">

    <center>
        <!-- Wrap everything in VBox to allow vertical centering -->
        <VBox alignment="CENTER">
            <HBox alignment="CENTER" spacing="20">
                <!-- Logo area -->
                <VBox alignment="CENTER" prefWidth="300">
                    <ImageView fitHeight="240" fitWidth="240" preserveRatio="true">
                        <Image url="@flashcardlogo.png"/>
                    </ImageView>
                </VBox>

                <!-- Login form area -->
                <VBox alignment="TOP_LEFT" spacing="15" maxWidth="300">
                    <padding>
                        <Insets top="30" right="20" bottom="20" left="20"/>
                    </padding>

                    <!-- Title -->
                    <Label text="LOGIN" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

                    <!-- Username -->
                    <TextField fx:id="usernameField" promptText="Student number" maxWidth="Infinity"/>

                    <!-- Password -->
                    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="Infinity"/>

                    <!-- Login button -->
                    <Button fx:id="loginButton" text="Login" onAction="#handleLogin" maxWidth="Infinity"
                            style="-fx-background-color: #60C3D8; -fx-text-fill: white; -fx-font-weight: bold;" />

                    <!-- Account creation -->
                    <HBox spacing="5">
                        <Label text="New here?" />
                        <Label text="Create Account"
                               fx:id="createAccountButton"
                               onMouseClicked="#handleCreateAccount"
                               style="-fx-text-fill: #007BFF; -fx-underline: true; -fx-cursor: hand;" />
                    </HBox>

                    <!-- Error message -->
                    <Label fx:id="errorLabel"
                           style="-fx-font-size: 14px; -fx-text-fill: red;"
                           textAlignment="CENTER"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>