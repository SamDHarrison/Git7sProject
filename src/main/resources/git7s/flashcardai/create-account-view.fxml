<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/17.0.12"
            fx:controller="git7s.flashcardai.controller.CreateAccountController">

    <center>
        <!-- Vertically center all content -->
        <VBox alignment="CENTER" spacing="20">
            <!-- Form and title -->
            <VBox alignment="TOP_LEFT" spacing="15" maxWidth="400">
                <padding>
                    <Insets top="15" right="20" bottom="20" left="70"/>
                </padding>

                <!-- Title -->
                <Label text="CREATE ACCOUNT" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

                <!-- Student Number -->
                <TextField fx:id="usernameField" promptText="Student number" prefWidth="145" maxWidth="145"/>

                <!-- First and Last Name -->
                <HBox spacing="10">
                    <TextField fx:id="firstNameField" promptText="First Name" prefWidth="150"/>
                    <TextField fx:id="lastNameField" promptText="Last Name" prefWidth="150"/>
                </HBox>

                <!-- Password and Confirm Password -->
                <HBox spacing="10">
                    <PasswordField fx:id="passwordField" promptText="Password" prefWidth="150"/>
                    <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password" prefWidth="150"/>
                </HBox>

                <!-- Get Started Button -->
                <Button text="Get Started!" onAction="#handleGetStarted" prefWidth="320"
                        style="-fx-background-color: #60C3D8; -fx-text-fill: white; -fx-font-weight: bold;" />

                <!-- Error label -->
                <Label fx:id="errorLabel" style="-fx-font-size: 14px; -fx-text-fill: red;" textAlignment="CENTER"/>
            </VBox>
        </VBox>
    </center>

    <!-- Back button (top-left corner) -->
    <top>
        <HBox alignment="TOP_LEFT">
            <Button text="Back" onAction="#handleBackToLogin"
                    style="-fx-background-color: #d3d3d3; -fx-text-fill: #000000; -fx-border-color: grey;" />
        </HBox>
    </top>
</BorderPane>